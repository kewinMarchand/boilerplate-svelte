{
  "ci": {
    "collect": {
      "startServerCommand": "PORT=4059 PUBLIC_SITE_URL=http://localhost:4059 yarn start",
      "startServerReadyPattern": "Listening on",
      "url": [
        "http://localhost:4059/",
        "http://localhost:4059/taches",
        "http://localhost:4059/contact",
        "http://localhost:4059/catalogue",
        "http://localhost:4059/catalogue/plantes-interieur",
        "http://localhost:4059/catalogue/plantes-interieur/feuillages",
        "http://localhost:4059/blog",
        "http://localhost:4059/mentions-legales",
        "http://localhost:4059/donnees-personnelles",
        "http://localhost:4059/accessibilite",
        "http://localhost:4059/plan-du-site",
        "http://localhost:4059/blog/le-mode-accessibilite-renforcee",
        "http://localhost:4059/produit/monstera-deliciosa"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median"
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median"
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9,
            "aggregationMethod": "median"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
